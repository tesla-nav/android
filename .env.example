# Copy to .env (gitignored), fill in, then `set -a && source .env && set +a`.
# Quote values with $, &, or other shell-special characters (e.g. TESLA_CLIENT_SECRET='...'),
# otherwise `source` will try to expand/interpret them.

# Tesla dev app (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Allowed Origin registered on developer.tesla.com (bare host, no scheme/port) - used for step 4 partner registration
TESLA_DOMAIN=
